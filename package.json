{
  "name": "trackmymoney",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:db && next dev",
    "dev:db": "prisma generate && prisma db push",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node run-tests.js",
    "test:jest": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test --config=testEntrega3/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=testEntrega3/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=testEntrega3/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config=testEntrega3/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report testEntrega3/playwright-report",
    "test:bdd": "cucumber-js --config=cucumber.config.js",
    "test:bdd:watch": "cucumber-js --config=cucumber.config.js --watch",
    "test:bdd:report": "echo 'Reportes disponibles en tests/bdd/reports/'",
    "test:all": "npm run test:jest && npm run test:bdd",
    "postinstall": "prisma generate && prisma db push",
    "db:seed": "npx tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/localizations": "^3.14.2",
    "@clerk/nextjs": "^6.18.2",
    "@elastic/elasticsearch": "^8.18.2",
    "dexie": "^4.0.11",
    "framer-motion": "^12.9.2",
    "install": "^0.13.0",
    "lucide-react": "^0.503.0",
    "next": "14.2.28",
    "npm": "^11.3.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.5.2",
    "recharts": "^2.15.3",
    "swagger-ui-react": "^5.20.8"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.1",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.48.2",
    "@prisma/client": "^6.16.3",
    "@serenity-js/console-reporter": "^3.25.4",
    "@serenity-js/core": "^3.25.4",
    "@serenity-js/cucumber": "^3.25.4",
    "@serenity-js/serenity-bdd": "^3.25.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/hast": "^3.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/unist": "^3.0.3",
    "@types/use-sync-external-store": "^1.5.0",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.28",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8",
    "prisma": "^6.16.3",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
