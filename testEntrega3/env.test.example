# Variables de entorno para pruebas E2E
# =====================================
# 
# Este archivo contiene las credenciales de prueba para las pruebas E2E.
# IMPORTANTE: Estas credenciales deben ser de un usuario de prueba válido
# en tu aplicación Clerk.
#
# Copia este archivo como .env.test y actualiza las credenciales

# Credenciales del usuario de prueba
TEST_USER_EMAIL=test@trackmymoney.com
TEST_USER_PASSWORD=TestPassword123!

# URL base de la aplicación
BASE_URL=http://localhost:3000

# Configuración de Playwright
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOW_MO=100
